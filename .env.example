# Copie para .env (nunca commite o .env). Preencha só o que for usar.

# ----------------------------------------------------------------------------- LLM (qualquer provedor via PydanticAI)
# test = roteiro determinístico, sem rede. Exemplos reais:
#   openrouter:<modelo>   anthropic:<modelo>   google:<modelo>   openai:<modelo>
AGENT_MODEL=test
AGENT_FALLBACK_MODELS=          # opcional, separados por vírgula
AGENT_OUTPUT_MODE=tool          # tool | native | prompted (para modelos fracos em tool-calling)
AGENT_TEMPERATURE=0
AGENT_MAX_TOKENS=800
# Chave do provedor escolhido (só a que for usar). Modelos gratuitos: SOMENTE com dados fictícios (LGPD).
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# ----------------------------------------------------------------------------- seleção de adapters
CALENDAR_PROVIDER=fake          # fake | google | microsoft | caldav
STORAGE_BACKEND=memory          # memory | firestore
MESSAGING_PROVIDER=fake         # fake | whatsapp_cloud

# ----------------------------------------------------------------------------- Google Calendar
GOOGLE_CALENDAR_ID=             # ex.: dentista@gmail.com ou xxx@group.calendar.google.com
GOOGLE_CREDENTIALS_FILE=        # vazio no Cloud Run (usa a service account do serviço)

# ----------------------------------------------------------------------------- Microsoft 365 / Outlook
MS_AUTH_MODE=refresh_token      # refresh_token (Outlook pessoal) | client_credentials (M365 corporativo)
MS_TENANT_ID=consumers          # consumers para conta pessoal; id do tenant para M365
MS_CLIENT_ID=
MS_CLIENT_SECRET=               # só client_credentials
MS_REFRESH_TOKEN=               # gerado por: uv run clinic ms-login
MS_USER_ID=                     # só client_credentials (e-mail da caixa)
MS_CALENDAR_ID=                 # vazio = agenda padrão

# ----------------------------------------------------------------------------- CalDAV (iCloud, Nextcloud…)
CALDAV_URL=                     # iCloud: https://caldav.icloud.com
CALDAV_USERNAME=
CALDAV_PASSWORD=                # iCloud: senha específica de app
CALDAV_CALENDAR_NAME=

# ----------------------------------------------------------------------------- WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0

# ----------------------------------------------------------------------------- Firestore / jobs
FIRESTORE_PROJECT=
FIRESTORE_DATABASE=(default)
JOBS_TOKEN=                     # segredo longo e aleatório (openssl rand -hex 32)
LOG_LEVEL=INFO
